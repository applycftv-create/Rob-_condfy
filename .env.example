# Copie este arquivo para ".env" (na raiz do projeto) e preencha com valores reais.
# O arquivo ".env" NUNCA deve ser commitado no git (já está no .gitignore).

CONDFY_USERNAME=seu-usuario-ou-email-do-condfy
CONDFY_PASSWORD=sua-senha-do-condfy

GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=senha-de-app-gerada-em-myaccount.google.com/apppasswords

# Um ou mais e-mails, separados por vírgula:
NOTIFY_EMAIL=retaguarda2@applycftv.com.br,retaguarda1@applycftv.com.br,apply@applycftv.com.br,suporte@applycftv.com.br

# Opcional: notificação por WhatsApp via CallMeBot (veja README para o passo
# a passo de ativação). Formato "telefone:apikey", um ou mais separados por
# vírgula — cada pessoa precisa ativar o próprio número e gerar sua apikey.
# Deixe vazio para não enviar WhatsApp.
WHATSAPP_RECIPIENTS=5511999999999:sua-apikey-aqui
